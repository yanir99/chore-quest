# Copy to .env, set a private parent PIN, and use your household's IANA timezone.
ADMIN_PIN=replace-with-a-private-pin
TZ=UTC
PORT=3000
# Set to 1 only if one trusted reverse proxy is the only network path to this app and forwards X-Forwarded-Proto.
TRUST_PROXY=0
# Optional: generate with `npm run vapid` and paste the resulting key values here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
