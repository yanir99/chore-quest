{
  "name": "chore-quest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --config client/vite.config.js --host 0.0.0.0\"",
    "start": "node server/index.js",
    "build": "vite build --config client/vite.config.js",
    "test": "node --test",
    "vapid": "web-push generate-vapid-keys --json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "vite": "^6.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.21.5": true
  }
}
